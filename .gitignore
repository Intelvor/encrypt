# ===== 编译产物 =====
*.o
*.obj
*.exe
*.class
*.dex
*.apk
*.idsig
*.a
*.dll

# ===== 统一构建产物目录 =====
build/

# ===== Android SDK / 构建 =====
android/sdk/
android/sdk-tools/
android/build/classes/
android/build/dexout/
android/build/base.apk
android/build/aligned.apk
android/build/*.idsig
# keystore 是签名密钥，不入库
android/build/*.keystore

# ===== Android SDK 工具压缩包 =====
*.zip

# ===== cuix 重构版（实验性，未随主仓库分发）=====
# 构建产物与第三方源码（quickjs 等）不入库；源码在 core-ui 独立仓库
desktop/cuix/build/

# ===== 临时文件 =====
*.tmp
*.log
thumbs.db
.DS_Store
